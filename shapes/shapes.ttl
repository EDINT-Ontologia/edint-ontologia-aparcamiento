<https://astrea.linkeddata.es/shapes#de4a2a2c653b8b84747c854220c1a5fa> a sh:PropertyShape ;
    rdfs:label "Number of parking spots. Can be used to represent the total number of spots, or the  number of spots by vehicle type or by permit type. For example, 50 spots for cars, 10 for motorcycles."@en,
        "number of parking spots"@en,
        "Número de plazas de aparcamiento. Se puede usar para representar el número total de plazas, o el número de plazas por tipo de vehículo o por tipo de permiso. Por ejemplo, 50 plazas para coches y 10 para motos."@es,
        "número de plazas de aparcamiento"@es ;
    sh:datatype xsd:integer ;
    sh:description "Number of parking spots. Can be used to represent the total number of spots, or the  number of spots by vehicle type or by permit type. For example, 50 spots for cars, 10 for motorcycles."@en,
        "Número de plazas de aparcamiento. Se puede usar para representar el número total de plazas, o el número de plazas por tipo de vehículo o por tipo de permiso. Por ejemplo, 50 plazas para coches y 10 para motos."@es ;
    sh:name "number of parking spots"@en,
        "número de plazas de aparcamiento"@es ;
    sh:nodeKind sh:Literal ;
    sh:path :numberOfParkingSpots ;
    sh:pattern "[\\-+]?[0-9]+" .

